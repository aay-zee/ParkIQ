# Copy to .env and fill in local configuration.
# EXPO_PUBLIC values are bundled into the app; use restricted demo credentials.
EXPO_PUBLIC_ADMIN_USER=your_demo_username
EXPO_PUBLIC_ADMIN_PASS=your_demo_password
EXPO_PUBLIC_MQTT_HOST=your_cluster.s1.eu.hivemq.cloud
EXPO_PUBLIC_MQTT_PORT=8884
EXPO_PUBLIC_MQTT_USER=your_mqtt_username
EXPO_PUBLIC_MQTT_PASS=your_mqtt_password
